# Session / auth
SESSION_SECRET=            # generate with `openssl rand -base64 32`

# Database (Prisma)
DATABASE_URL=              # postgresql://user:password@host:5432/demandpulse

# AI Copilot (Module E)
ANTHROPIC_API_KEY=         # required for /api/copilot

# External ML model microservice (optional — Prophet/XGBoost/LightGBM wrapper)
EXTERNAL_FORECAST_MODEL_URL=
EXTERNAL_FORECAST_MODEL_API_KEY=

# Password reset email (see lib/email/send-password-reset.ts)
NEXT_PUBLIC_APP_URL=       # e.g. https://app.yourdomain.com — used to build the reset link. Falls back to the request origin if unset.
EMAIL_PROVIDER_API_KEY=    # Resend/SendGrid/Postmark/etc. Reset links log to the console in dev without this.
